# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Prefer supplying these via TF_VAR_* environment variables so no secret ever lands on disk.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Postgres admin password - required. Supply via TF_VAR_postgres_admin_password, not here.
# postgres_admin_password = "..."

# Optional: your workstation's public IP, so ingestion can reach Postgres from outside Azure.
# allowed_client_ip = "203.0.113.10"

# Optional: the built container image to deploy.
# container_image = "ghcr.io/dbhq-uk/fca-handbook-assistant:<tag>"
